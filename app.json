{
  "expo": {
    "scheme": "viewer-memo",
    "name": "Viewer Memo for Notion",
    "slug": "viewer-memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",

    "android": {
      "package": "com.gizag.notionmemo",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "viewer-memo"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "https",
            "host": "viewer-memo.gizaguri0426.workers.dev",
            "pathPrefix": "/auth-success"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx",
          "iosAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
       [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8138082752217427~3440482983",
          "iosAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx"
        }
      ],
      "react-native-android-widget",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "gizag889",
          "organization": "gizag889"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "549c2150-1af5-4083-b189-1f151b461f72"
      }
    },
    "owner": "gizag889"
  }
}
